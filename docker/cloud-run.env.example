# Runtime
HOST=0.0.0.0
PORT=3000
MODE=main
APP_URL=https://flowise-api.example.com
TRUST_PROXY=true
DISABLE_FLOWISE_TELEMETRY=true
LOG_LEVEL=info

# Supabase PostgreSQL - persistent container/session pooler
DATABASE_TYPE=postgres
DATABASE_HOST=aws-REGION.pooler.supabase.com
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=postgres.PROJECT_REF
DATABASE_PASSWORD=replace-me
DATABASE_SSL=true
DATABASE_REJECT_UNAUTHORIZED=false

# Keep this value stable across every deployment.
FLOWISE_SECRETKEY_OVERWRITE=replace-with-a-long-random-secret

# Supabase Storage S3 compatibility
STORAGE_TYPE=s3
S3_STORAGE_BUCKET_NAME=flowise
S3_STORAGE_ACCESS_KEY_ID=replace-me
S3_STORAGE_SECRET_ACCESS_KEY=replace-me
S3_STORAGE_REGION=project-region
S3_ENDPOINT_URL=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
S3_FORCE_PATH_STYLE=true

# Client API for Next.js, Tauri 2 and Plasmo
CLIENT_API_ENABLED=true
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-me
CLIENT_API_AUTO_LINK_BY_EMAIL=false
CLIENT_ALLOWED_ORIGINS=https://app.example.com,http://tauri.localhost,https://tauri.localhost,chrome-extension://EXTENSION_ID
CORS_ALLOW_CREDENTIALS=false
IFRAME_ORIGINS=https://app.example.com
