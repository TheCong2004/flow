# Flowise runs as an execution service behind Merchant.
CLIENT_API_ENABLED=true
CLIENT_API_AUTH_MODE=merchant
MERCHANT_INTERNAL_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Browser clients call Merchant. This remains an explicit defensive allowlist.
CLIENT_ALLOWED_ORIGINS=https://app.example.com,tauri://localhost,http://tauri.localhost,chrome-extension://extension-id

# Supabase PostgreSQL
DATABASE_TYPE=postgres
DATABASE_HOST=aws-0-region.pooler.supabase.com
DATABASE_PORT=6543
DATABASE_NAME=postgres
DATABASE_USER=postgres.project-ref
DATABASE_PASSWORD=replace-me
DATABASE_SSL=true

# Supabase Storage through its S3-compatible endpoint
STORAGE_TYPE=s3
S3_STORAGE_BUCKET_NAME=flowise
S3_STORAGE_ACCESS_KEY_ID=replace-me
S3_STORAGE_SECRET_ACCESS_KEY=replace-me
S3_ENDPOINT_URL=https://project-ref.storage.supabase.co/storage/v1/s3
S3_FORCE_PATH_STYLE=true

HOST=0.0.0.0
PORT=8080
